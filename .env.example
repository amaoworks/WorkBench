# Docker Compose reads this file after it is copied to .env. Workbench itself does not load .env.
WORKBENCH_HTTP_PORT=8080
WORKBENCH_PORT=8080
WORKBENCH_AUTH=password
WORKBENCH_DATA=/data/data.db
WORKBENCH_DB_DRIVER=postgres
POSTGRES_DB=workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD='workbench-local'
POSTGRES_PORT=5432
WORKBENCH_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
WORKBENCH_ALLOW_INSECURE_HTTP=true
WORKBENCH_ALLOWED_HOSTS=localhost:${WORKBENCH_PORT},127.0.0.1:${WORKBENCH_PORT}
WORKBENCH_PUBLIC_URL=
WORKBENCH_CORS_ALLOW_ORIGIN=

# Initial threshold only; the saved workspace setting takes precedence.
WORKBENCH_LOG_LEVEL=info
# Futu connection is deployment configuration; account/password are set in 投资设置.
WORKBENCH_FUTU_OPEND_ADDRESS=127.0.0.1:11111
WORKBENCH_FUTU_ALLOW_NON_LOCAL=false
# Native Linux x86_64: optional overrides; OpenD starts from investment settings.
# WORKBENCH_FUTU_RUNTIME_DIR=/var/lib/workbench/futu-opend
# WORKBENCH_FUTU_OPEND_BINARY=/opt/FutuOpenD/FutuOpenD

# Used only with compose.image.yaml. Replace the example version with a published tag.
# WORKBENCH_IMAGE=ghcr.io/amaoworks/workbench
# WORKBENCH_VERSION=v0.1.1
