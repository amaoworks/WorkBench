# Docker Compose reads this file after it is copied to .env. Workbench itself does not load .env.

# Host port published on 127.0.0.1 (container always listens on 8080).
WORKBENCH_HOST_PORT=8080

# Built-in PostgreSQL (required; set a strong password before starting).
POSTGRES_PASSWORD=
# POSTGRES_DB=workbench
# POSTGRES_USER=workbench

# External PostgreSQL: uncomment and set the full DSN (URL-encode reserved characters in the password).
# WORKBENCH_DATABASE_URL=postgresql://workbench:password@db.example.com:5432/workbench?sslmode=require
# Switch to SQLite (data stored in workbench_data volume; keep WORKBENCH_DATABASE_URL empty).
# WORKBENCH_DB_DRIVER=sqlite
# WORKBENCH_DATABASE_URL=

# Reverse proxy / browser access.
# WORKBENCH_PUBLIC_URL=https://workbench.example.com
# WORKBENCH_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080
# WORKBENCH_CORS_ALLOW_ORIGIN=

# Initial threshold only; the saved workspace setting takes precedence.
# WORKBENCH_LOG_LEVEL=info

# Mobile push: configure at least one provider and enable the matching volume mount in compose.yaml.
# WORKBENCH_MOBILE_PUSH_ENABLED=true
# WORKBENCH_MOBILE_PUSH_APNS_P8_FILE=/run/secrets/workbench/apns.p8
# WORKBENCH_MOBILE_PUSH_APNS_TEAM_ID=
# WORKBENCH_MOBILE_PUSH_APNS_KEY_ID=
# WORKBENCH_MOBILE_PUSH_APNS_BUNDLE_ID=com.example.workbench
# WORKBENCH_MOBILE_PUSH_APNS_SANDBOX=false
# WORKBENCH_MOBILE_PUSH_FCM_SERVICE_ACCOUNT_FILE=/run/secrets/workbench/fcm-service-account.json

# Used only with compose.image.yaml. Replace the example version with a published tag.
# WORKBENCH_IMAGE=ghcr.io/amaoworks/workbench
# WORKBENCH_VERSION=v0.1.1

# Used only with deploy/compose.proxy.yaml. Name of the existing reverse-proxy network.
# WORKBENCH_PROXY_NETWORK=proxy
