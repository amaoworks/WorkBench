# Compose reads this file after it is copied to .env. Workbench itself does not load .env.
WORKBENCH_IMAGE=ghcr.io/amaoworks/workbench
# Replace with an existing GitHub release tag; v0.1.1 is an example.
WORKBENCH_VERSION=v0.1.1
WORKBENCH_PORT=8080
# Initial threshold only; the saved workspace setting takes precedence.
WORKBENCH_LOG_LEVEL=info
WORKBENCH_PUBLIC_URL=https://workbench.example.com
# Required on first start. Use a unique password with at least 8 characters and
# at least 3 categories: uppercase, lowercase, digits, symbols.
# Single quotes preserve literal $ and # in Docker Compose's .env parser.
WORKBENCH_PASSWORD=''
