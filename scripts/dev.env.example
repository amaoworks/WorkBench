# Development settings for ./scripts/dev.sh --config FILE. Same syntax as the Compose .env file.
# Copy to an ignored path, for example: cp scripts/dev.env.example .env.dev && chmod 600 .env.dev
# Then start with: ./scripts/dev.sh --config .env.dev
# Precedence: command-line flags > shell environment > this file > defaults.

# Go backend (same as -auth, -listen, -log-level).
WORKBENCH_AUTH=password
WORKBENCH_LISTEN=127.0.0.1:9091
WORKBENCH_LOG_LEVEL=debug

# Vite dev server (same as --web-port, --web-host, --dev-url).
WORKBENCH_DEV_WEB_PORT=9090
# WORKBENCH_DEV_WEB_HOST=127.0.0.1
# WORKBENCH_DEV_URL=https://dev.example.com

# HTTPS reverse proxy in front of Vite (same as -public-url, -allowed-host).
# The public URL host is allowed automatically; list extra hosts comma-separated.
# WORKBENCH_PUBLIC_URL=https://dev.example.com
# WORKBENCH_ALLOWED_HOSTS=dev.example.com

# Without a data setting dev.sh uses .workbench/dev/data.db (relative to the repository).
# Set ~/.workbench/data.db to reuse the native workspace.
# WORKBENCH_DATA=.workbench/dev/data.db

# PostgreSQL: ./scripts/db-manage.sh init writes a ready-made file with these values.
# A native process reaches PostgreSQL through a host port, not the Compose service name `postgres`.
# WORKBENCH_DB_DRIVER=postgres
# WORKBENCH_DATABASE_URL=postgresql://workbench:replace-me@127.0.0.1:5432/workbench?sslmode=disable
