# Development settings for ./scripts/dev.sh --config FILE. Same syntax as the Compose .env file.
# Copy to an ignored path, for example: cp scripts/dev.env.example .env.dev && chmod 600 .env.dev
# Precedence: command-line flags > shell environment > this file > defaults.
WORKBENCH_AUTH=password
WORKBENCH_LISTEN=127.0.0.1:9091
# Vite port and bind host (same as --web-port / --web-host).
WORKBENCH_DEV_PORT=9090
# WORKBENCH_DEV_HOST=127.0.0.1
# Relative paths resolve from the repository root; keep dev data away from ~/.workbench.
WORKBENCH_DATA=.workbench/dev/data.db
WORKBENCH_LOG_LEVEL=debug
# HTTPS reverse proxy in front of Vite.
# WORKBENCH_PUBLIC_URL=https://dev.example.com
# WORKBENCH_ALLOWED_HOSTS=dev.example.com

# PostgreSQL: a native process reaches the database through a host port, not the
# Compose service name `postgres`. Create the database first.
# WORKBENCH_DB_DRIVER=postgres
# POSTGRES_USER=workbench
# POSTGRES_PASSWORD=replace-me
# POSTGRES_DB=workbench_dev
# POSTGRES_PORT=5432
# WORKBENCH_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
