# Install in the nginx http context; replace the domain and certificate paths.
map $http_upgrade $workbench_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name workbench.example.com;
    return 308 https://workbench.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name workbench.example.com;
    ssl_certificate /etc/letsencrypt/live/workbench.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/workbench.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $workbench_connection_upgrade;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
