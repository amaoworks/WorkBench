# systemd EnvironmentFile syntax. Replace the public origin.
WORKBENCH_LISTEN=127.0.0.1:8080
# Optional port override; an explicit -listen command-line flag takes precedence.
# WORKBENCH_HTTP_PORT=8080
WORKBENCH_DATA=/var/lib/workbench/data.db
WORKBENCH_DB_DRIVER=sqlite
# PostgreSQL new workspace: set the driver to postgres and create the database first.
# WORKBENCH_DATABASE_URL=postgresql://workbench:password@db.example.com:5432/workbench?sslmode=require
WORKBENCH_AUTH=password
# Initial threshold only; the saved workspace setting takes precedence.
WORKBENCH_LOG_LEVEL=info
WORKBENCH_PUBLIC_URL=https://workbench.example.com
# Optional comma-separated browser origins. HTTPS deployments require HTTPS origins.
# WORKBENCH_CORS_ALLOW_ORIGIN=https://admin.example.com
# Keep false for a loopback listener or HTTPS reverse proxy.
# WORKBENCH_ALLOW_INSECURE_HTTP=false
# The initial password is generated once. Read it with: journalctl -u workbench
