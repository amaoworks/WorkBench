# Futu / moomoo platform account (NiuNiu ID, phone, or email).
FUTU_ACCOUNT_ID=

# 32-char hex MD5 of the login password (not the password itself):
#   printf '%s' 'your-password' | md5sum | awk '{print $1}'
FUTU_ACCOUNT_PWD_MD5=

# OpenD build to download on first start (official Ubuntu tarball).
FUTU_OPEND_VER=10.10.7008

FUTU_OPEND_IP=0.0.0.0
FUTU_OPEND_PORT=11111
FUTU_OPEND_TELNET_PORT=22222
FUTU_LANG=chs
FUTU_LOG_LEVEL=info
